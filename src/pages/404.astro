---
import '../styles/global.css';
import '../styles/fonts.css';
---

<!doctype html>
<html lang="en">
  <head>
    <script>
      (function () {
        let theme = null;
        try {
          theme = localStorage.getItem("theme");
        } catch (err) {
          theme = null;
        }
        if (!theme) {
          theme = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <script>
      import '../js/main';
    </script>
  </head>

  <body>
    <div class="content">
      <div
        class="main-box"
        id="home-main-box"
        role="main"
        style="padding-top: 8vh; padding-bottom: 23vh; margin-top: 13vh"
      >
        <div id="nametag" role="banner"></div>
        <div id="info-box">
          <h1 style="text-align: center; margin-top: 11vh">404</h1>
          <p style="text-align: center">
            The page you requested could not be found.<br />
            <a
              href="https://docs.google.com/forms/d/e/1FAIpQLScwoKSehRxSQzPul2lhwC2qJQt-OfoIzuKw27ZRan4T3ckIDQ/viewform?usp=dialog"
              target="_blank"
              rel="noopener noreferrer"
              style="font-size: 13px"
              >How'd you get to my 404 page?</a>
              <br>
              <a
              href="/index"
              style="font-size: 13px"
              >Home</a>
          </p>
        </div>
      </div>
    </div>

    <div id="footer" role="contentinfo"></div>

    <div id="popup"></div>


  </body>
</html>
